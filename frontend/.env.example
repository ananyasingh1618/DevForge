# Copy to frontend/.env and fill in real values for local (non-Docker)
# development. Never commit a real .env file. Full documentation:
# ../docs/CONFIGURATION.md.

# Vite inlines VITE_* variables into the built JS bundle at build time — the
# browser (not a Docker-internal network) must be able to reach this URL.
VITE_API_URL=http://localhost:4000
