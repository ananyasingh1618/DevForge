# Copy the relevant section to a real .env file in that package's directory
# (api/.env, frontend/.env) and fill in real values. Never commit a real .env
# file. These are the values used for local (non-Docker) development; Docker
# Compose sets its own environment directly in docker-compose.yml (notably a
# different DATABASE_URL, since containers reach Postgres via the Docker
# network hostname "postgres", not "localhost").

# --- api/.env ---
NODE_ENV=development
PORT=4000
# Host port 5433, not 5432 — this machine may already run a native Postgres
# on 5432 for other projects; see docker-compose.yml's comment on this.
DATABASE_URL=postgresql://devforge:devforge@localhost:5433/devforge
# Hashes session tokens (SHA-256) and is a general server secret.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string
FRONTEND_ORIGIN=http://localhost:5173

# --- frontend/.env ---
VITE_API_URL=http://localhost:4000

# --- ai-service ---
# No .env needed yet — the service is an inert health-check-only stub (see
# ai-service/main.py). Runs on port 8001 locally and in Docker Compose
# (not 8000, which may already be in use by other local tools).
