# Copy this file to .env in the same directory and fill in real values.
# Never commit the real .env file.

# --- api/.env ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://devforge:devforge@localhost:5432/devforge
# Used to hash session tokens (SHA-256) and as a general server secret.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string
FRONTEND_ORIGIN=http://localhost:5173

# --- frontend/.env ---
VITE_API_URL=http://localhost:4000
