# Copy the relevant section to a real .env file in that package's directory
# (api/.env, frontend/.env, ai-service/.env) and fill in real values. Never
# commit a real .env file. These are the values used for local (non-Docker)
# development; Docker Compose sets its own environment directly in
# docker-compose.yml (notably a different DATABASE_URL, since containers
# reach Postgres via the Docker network hostname "postgres", not
# "localhost"). Every variable here is documented in full in
# docs/CONFIGURATION.md — keep the two in sync when either changes.
#
# Per-package copies of this file also exist (api/.env.example,
# frontend/.env.example, ai-service/.env.example) for tooling that expects
# an .env.example next to the .env it loads; this root file is the single
# source of truth all three are kept in sync with.

# --- api/.env ---
NODE_ENV=development
PORT=4000
# Host port 5433, not 5432 — this machine may already run a native Postgres
# on 5432 for other projects; see docker-compose.yml's comment on this.
DATABASE_URL=postgresql://devforge:devforge@localhost:5433/devforge
# Hashes session tokens (SHA-256) and is a general server secret.
# Generate with: openssl rand -hex 32
# Startup fails fast in production if this is left as this example value —
# see api/src/env.ts's KNOWN_PLACEHOLDER_SECRETS.
SESSION_SECRET=replace-with-a-random-64-char-hex-string
# The frontend origin CORS is allowed to send credentialed requests from.
# Startup fails fast in production if this is left at a localhost default.
FRONTEND_ORIGIN=http://localhost:5173
# Where the api reaches ai-service. Docker Compose overrides this to the
# in-network hostname (http://ai-service:8001); this default is for local
# (non-Docker) development, where both run as separate local processes.
AI_SERVICE_URL=http://localhost:8001
# Optional — unset means GitHub repository connection/indexing is disabled
# (routes return 503 GITHUB_INTEGRATION_NOT_CONFIGURED, everything else
# still works). Must be a base64-encoded 32-byte key (AES-256-GCM), used to
# encrypt stored GitHub tokens at rest. Generate with:
#   openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
# Structured-log verbosity: debug | info | warn | error. "info" is a good
# local-development default; production deployments typically prefer
# "warn" so routine request logs don't drown out real problems.
LOG_LEVEL=info
# Postgres connection-pool sizing (api/src/lib/prisma.ts) — safe defaults,
# rarely need changing outside of load testing or a genuinely
# high-concurrency deployment.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# --- frontend/.env ---
# The browser-facing API URL — must be reachable from wherever the user's
# browser runs (not a Docker-internal hostname), since Vite inlines this at
# build time and it ends up in the shipped JS bundle.
VITE_API_URL=http://localhost:4000

# --- ai-service/.env ---
# All three optional. Unset means ai-service still starts and serves /health
# normally, but real-provider endpoints (requirements/PRD/architecture/
# epic/task generation, codebase Q&A, AI code review, embeddings) return a
# real, honest 503 PROVIDER_NOT_CONFIGURED instead of a fabricated result —
# the same behavior local dev and this evaluation environment run with.
#
# GEMINI_API_KEY and ANTHROPIC_API_KEY are two independent, fully supported
# LLM providers for every generation/Q&A/review feature — set either one to
# enable real content. If GEMINI_API_KEY is set, Gemini is used (it has a
# genuinely free tier — get a key at https://aistudio.google.com/apikey,
# no billing setup required to start). If only ANTHROPIC_API_KEY is set,
# Anthropic is used instead. If both are set, Gemini wins.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Unrelated to the two above — enables real Voyage AI embeddings for code
# search (and, transitively, codebase Q&A and AI code review).
VOYAGE_API_KEY=
