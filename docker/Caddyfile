# The single public entrypoint for DevForge (docker/docker-compose.prod.yml).
# Plain HTTP on :8080 inside the container — TLS is terminated by the
# Cloudflare tunnel in front of it, so Caddy must not try to get certificates.
{
	admin off
	auto_https off
	servers {
		# cloudflared reaches Caddy from a private (Docker-gateway) address, so
		# only then is Cloudflare's CF-Connecting-IP trusted to name the real
		# client. Anyone else's forwarded headers are ignored.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip
	header -Server

	handle /healthz {
		respond "ok" 200
	}

	# API: an ALLOWLIST of exactly the prefixes the frontend uses, mounted
	# under /api. Everything else under /api — notably the API's
	# unauthenticated /metrics, /metrics.json and /ready, and any route added
	# later — is a 404 unless deliberately added here.
	@api path /api/auth /api/auth/* /api/projects /api/projects/* /api/evaluations /api/evaluations/* /api/health
	handle @api {
		request_body {
			max_size 1MB
		}
		uri strip_prefix /api
		reverse_proxy api:4000 {
			# Replace (not append to) the forwarded chain with the one address
			# Caddy resolved as the client; the API trusts exactly this 1 hop.
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}
	@apiRest path /api /api/*
	handle @apiRest {
		respond "Not found" 404
	}

	# Dot-files/dirs (/.env, /.git/config, ...) never exist in the image; make
	# that an explicit 404 rather than falling through to the SPA shell.
	@dotfiles path */.*
	handle @dotfiles {
		respond "Not found" 404
	}

	# Static SPA.
	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes (no file extension) get index.html so a refresh or
		# deep link works; a missing *file* (foo.map, foo.js, /.env) is a real 404.
		@spa not path_regexp \.[A-Za-z0-9]+$
		rewrite @spa /index.html
		file_server
	}
}
