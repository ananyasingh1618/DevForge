{
  "name": "devforge",
  "private": true,
  "version": "0.0.0",
  "description": "DevForge — AI Software Engineering & Codebase Intelligence Platform (Foundation phase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @devforge/api dev",
    "dev:frontend": "pnpm --filter @devforge/frontend dev",
    "build": "pnpm --filter @devforge/api build && pnpm --filter @devforge/frontend build",
    "test": "pnpm --filter @devforge/api test && pnpm --filter @devforge/frontend test",
    "test:integration": "pnpm --filter @devforge/api test:integration",
    "lint": "pnpm --filter @devforge/api lint && pnpm --filter @devforge/frontend lint",
    "typecheck": "pnpm --filter @devforge/api typecheck && pnpm --filter @devforge/frontend typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "prisma"]
  }
}
