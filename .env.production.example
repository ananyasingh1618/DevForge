# Template for the gitignored .env.production that scripts/start-prod.sh
# creates for you (with freshly generated random secrets). Never commit a real
# .env.production. Values below are placeholders only.

# Generated by start-prod.sh: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me
# Generated by start-prod.sh: openssl rand -hex 32
SESSION_SECRET=replace-me
# Generated by start-prod.sh: openssl rand -base64 32 (encrypts stored GitHub
# tokens at rest — changing it later makes already-stored tokens unreadable)
GITHUB_TOKEN_ENCRYPTION_KEY=replace-me

# Optional AI providers. Unset = the matching features return an honest 503
# "not configured", never fabricated output. start-prod.sh copies these from
# the repo's root .env on first creation if they are set there.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Loopback port the public entrypoint (Caddy) listens on.
WEB_PORT=8090
