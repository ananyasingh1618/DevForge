// DevForge — Prisma schema
// Foundation phase models: users, sessions, projects.
// Phase 2 (Requirements Analysis) adds: requirements_versions.
// Phase 3 (PRD Generation) adds: prd_versions.
// Phase 4 (Architecture Generation) adds: architecture_versions.
// Phase 5 (Epics & Tasks Generation) adds: epic_versions, task_versions.
// Phase 6 (GitHub Integration) adds: repository_connections — a single
// connection row per project (not a versioned artifact; see
// docs/GITHUB_INTEGRATION_PHASE_PLAN.md for why).
// Future entities (code_chunks, conversations, reviews, review_findings,
// feedback) are intentionally not modeled yet — see
// docs/GITHUB_INTEGRATION_PHASE_PLAN.md, docs/EPICS_TASKS_PHASE_PLAN.md,
// docs/ARCHITECTURE_PHASE_PLAN.md, docs/PRD_PHASE_PLAN.md,
// docs/REQUIREMENTS_PHASE_PLAN.md and docs/FOUNDATION_PROGRESS.md for how
// they will attach to `projects` / `repository_connections` once those
// phases start.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("users")
}

// Opaque server-side sessions: the raw token is never stored, only a SHA-256
// hash of it (see api/src/services/auth.ts, added in Milestone 5). The raw
// token lives only in the httpOnly session cookie on the client.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectStatus {
  planning
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  name        String
  description String?
  status      ProjectStatus @default(planning)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requirementsVersions RequirementsVersion[]
  prdVersions          PrdVersion[]
  architectureVersions ArchitectureVersion[]
  epicVersions         EpicVersion[]
  taskVersions         TaskVersion[]
  repositoryConnection RepositoryConnection?

  @@index([ownerId])
  @@map("projects")
}

// One row per requirements analysis run (or manual edit) for a project.
// `content` is validated structured JSON (see api/src/schemas/requirements.ts
// and ai-service/app/schemas.py — the same shape on both sides), never a raw
// LLM response or an unstructured blob. `isActive` marks the single version
// currently "in use" for the project; the service layer enforces at most one
// active version per project inside a transaction (see
// api/src/services/requirements.ts).
model RequirementsVersion {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  version   Int
  ideaText  String   @map("idea_text")
  content   Json
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prdVersions PrdVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("requirements_versions")
}

// One row per PRD generation run (or manual edit) for a project. `content`
// is validated structured JSON, generated from — and tracing back to —
// whichever RequirementsVersion was active at generation time via
// `sourceRequirementsVersionId`. Same single-active-version invariant as
// RequirementsVersion, enforced the same way (see
// api/src/services/prd.ts).
model PrdVersion {
  id                          String   @id @default(uuid())
  projectId                   String   @map("project_id")
  version                     Int
  sourceRequirementsVersionId String   @map("source_requirements_version_id")
  content                     Json
  isActive                    Boolean  @default(false) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRequirementsVersion RequirementsVersion   @relation(fields: [sourceRequirementsVersionId], references: [id])
  architectureVersions      ArchitectureVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceRequirementsVersionId])
  @@map("prd_versions")
}

// One row per architecture-generation run (or manual edit) for a project.
// `content` is validated structured JSON, generated from — and tracing back
// to — whichever PrdVersion was active at generation time via
// `sourcePrdVersionId`. Same single-active-version invariant as PrdVersion,
// enforced the same way (see api/src/services/architecture.ts).
model ArchitectureVersion {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  version            Int
  sourcePrdVersionId String   @map("source_prd_version_id")
  content            Json
  isActive           Boolean  @default(false) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourcePrdVersion PrdVersion    @relation(fields: [sourcePrdVersionId], references: [id])
  epicVersions     EpicVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourcePrdVersionId])
  @@map("architecture_versions")
}

// One row per epic-generation run (or manual edit) for a project. `content`
// is validated structured JSON — a list of id-bearing epic items (mirrors
// RequirementItem[], not PrdContent/ArchitectureContent's flat-sections
// shape) — generated from, and tracing back to, whichever ArchitectureVersion
// was active at generation time via `sourceArchitectureVersionId`. Same
// single-active-version invariant as every prior artifact, enforced the same
// way (see api/src/services/epics.ts).
model EpicVersion {
  id                          String   @id @default(uuid())
  projectId                   String   @map("project_id")
  version                     Int
  sourceArchitectureVersionId String   @map("source_architecture_version_id")
  content                     Json
  isActive                    Boolean  @default(false) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceArchitectureVersion ArchitectureVersion @relation(fields: [sourceArchitectureVersionId], references: [id])
  taskVersions              TaskVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceArchitectureVersionId])
  @@map("epic_versions")
}

// One row per task-generation run (or manual edit) for a project. `content`
// is validated structured JSON — a list of id-bearing task items, each
// referencing an epic id from the source EpicVersion's content via a plain
// `epicId` string field (not a DB-level foreign key — the same way no
// content field anywhere in this schema cross-references another content
// field's items by FK; content is JSON throughout). Generated from, and
// tracing back to, whichever EpicVersion was active at generation time via
// `sourceEpicVersionId`. Same single-active-version invariant as every prior
// artifact (see api/src/services/tasks.ts).
model TaskVersion {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  version             Int
  sourceEpicVersionId String   @map("source_epic_version_id")
  content             Json
  isActive            Boolean  @default(false) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEpicVersion EpicVersion @relation(fields: [sourceEpicVersionId], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceEpicVersionId])
  @@map("task_versions")
}

enum RepositoryConnectionStatus {
  pending
  verified
  error
}

// Exactly one connection per project (not a versioned artifact like every
// AI-generated table above — see docs/GITHUB_INTEGRATION_PHASE_PLAN.md for
// why a connection is modeled as replaced state rather than an append-only
// history). `encryptedToken` is never the plaintext PAT — see
// api/src/lib/githubTokenCrypto.ts for the AES-256-GCM scheme and
// api/src/env.ts for the (optional) GITHUB_TOKEN_ENCRYPTION_KEY it requires.
// `tokenLast4` is the only token-derived value ever safe to return to a
// client.
model RepositoryConnection {
  id                 String                     @id @default(uuid())
  projectId          String                     @unique @map("project_id")
  githubOwner        String                     @map("github_owner")
  githubRepo         String                     @map("github_repo")
  githubRepoId       String?                    @map("github_repo_id")
  githubAccountLogin String?                    @map("github_account_login")
  repositoryUrl      String                     @map("repository_url")
  defaultBranch      String?                    @map("default_branch")
  selectedBranch     String?                    @map("selected_branch")
  status             RepositoryConnectionStatus @default(pending)
  lastVerifiedAt     DateTime?                  @map("last_verified_at")
  lastError          String?                    @map("last_error")
  encryptedToken     String                     @map("encrypted_token")
  tokenLast4         String                     @map("token_last_4")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("repository_connections")
}
