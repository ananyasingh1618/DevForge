// DevForge — Prisma schema
// Foundation phase models: users, sessions, projects.
// Phase 2 (Requirements Analysis) adds: requirements_versions.
// Phase 3 (PRD Generation) adds: prd_versions.
// Phase 4 (Architecture Generation) adds: architecture_versions.
// Future entities (epics, tasks, repositories, code_chunks, conversations,
// reviews, review_findings, feedback) are intentionally not modeled yet —
// see docs/ARCHITECTURE_PHASE_PLAN.md, docs/PRD_PHASE_PLAN.md,
// docs/REQUIREMENTS_PHASE_PLAN.md and docs/FOUNDATION_PROGRESS.md for how
// they will attach to `projects` / `repositories` once those phases start.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("users")
}

// Opaque server-side sessions: the raw token is never stored, only a SHA-256
// hash of it (see api/src/services/auth.ts, added in Milestone 5). The raw
// token lives only in the httpOnly session cookie on the client.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectStatus {
  planning
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  name        String
  description String?
  status      ProjectStatus @default(planning)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requirementsVersions RequirementsVersion[]
  prdVersions          PrdVersion[]
  architectureVersions ArchitectureVersion[]

  @@index([ownerId])
  @@map("projects")
}

// One row per requirements analysis run (or manual edit) for a project.
// `content` is validated structured JSON (see api/src/schemas/requirements.ts
// and ai-service/app/schemas.py — the same shape on both sides), never a raw
// LLM response or an unstructured blob. `isActive` marks the single version
// currently "in use" for the project; the service layer enforces at most one
// active version per project inside a transaction (see
// api/src/services/requirements.ts).
model RequirementsVersion {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  version   Int
  ideaText  String   @map("idea_text")
  content   Json
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prdVersions PrdVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("requirements_versions")
}

// One row per PRD generation run (or manual edit) for a project. `content`
// is validated structured JSON, generated from — and tracing back to —
// whichever RequirementsVersion was active at generation time via
// `sourceRequirementsVersionId`. Same single-active-version invariant as
// RequirementsVersion, enforced the same way (see
// api/src/services/prd.ts).
model PrdVersion {
  id                          String   @id @default(uuid())
  projectId                   String   @map("project_id")
  version                     Int
  sourceRequirementsVersionId String   @map("source_requirements_version_id")
  content                     Json
  isActive                    Boolean  @default(false) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRequirementsVersion RequirementsVersion   @relation(fields: [sourceRequirementsVersionId], references: [id])
  architectureVersions      ArchitectureVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceRequirementsVersionId])
  @@map("prd_versions")
}

// One row per architecture-generation run (or manual edit) for a project.
// `content` is validated structured JSON, generated from — and tracing back
// to — whichever PrdVersion was active at generation time via
// `sourcePrdVersionId`. Same single-active-version invariant as PrdVersion,
// enforced the same way (see api/src/services/architecture.ts).
model ArchitectureVersion {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  version            Int
  sourcePrdVersionId String   @map("source_prd_version_id")
  content            Json
  isActive           Boolean  @default(false) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourcePrdVersion PrdVersion @relation(fields: [sourcePrdVersionId], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourcePrdVersionId])
  @@map("architecture_versions")
}
