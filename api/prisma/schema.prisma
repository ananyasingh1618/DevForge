// DevForge — Prisma schema
// Foundation phase models: users, sessions, projects.
// Phase 2 (Requirements Analysis) adds: requirements_versions.
// Phase 3 (PRD Generation) adds: prd_versions.
// Phase 4 (Architecture Generation) adds: architecture_versions.
// Phase 5 (Epics & Tasks Generation) adds: epic_versions, task_versions.
// Phase 6 (GitHub Integration) adds: repository_connections — a single
// connection row per project (not a versioned artifact; see
// docs/GITHUB_INTEGRATION_PHASE_PLAN.md for why).
// Phase 7 (AST Parsing & Codebase Indexing) adds: codebase_indexes,
// indexed_files, symbols — one index row per project (same
// replaced-state-not-versioned-artifact shape as repository_connections; see
// docs/CODEBASE_INDEX_PHASE_PLAN.md for why).
// Phase 8 (Retrieval & Semantic Search) adds: code_chunks, embeddings — chunks
// derived from Phase 7's indexed files/symbols, embedded via Voyage AI and
// ranked with cosine similarity computed in the Node API over plain
// PostgreSQL Float[] columns (not pgvector; see docs/RETRIEVAL_PHASE_PLAN.md
// for why).
// Phase 9 (Codebase Q&A) adds: questions, answers, answer_sources — a
// grounded Q&A layer over Phase 8 retrieval. answer_sources references
// code_chunks directly rather than duplicating path/line/content data; see
// docs/QA_PHASE_PLAN.md for the citation-safety design (the model never
// outputs a file path or line number itself).
// Phase 10 (AI Code Review) adds: code_reviews, code_review_sources,
// code_review_findings, code_review_finding_sources — a read-only review
// layer over Phase 8 retrieval, structurally the same shape as Phase 9's
// Q&A (retrieval -> structured-output provider -> citation validation ->
// persistence) but with evidence owned by the review (shared across many
// findings) rather than by one answer; see docs/CODE_REVIEW_PHASE_PLAN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("users")
}

// Opaque server-side sessions: the raw token is never stored, only a SHA-256
// hash of it (see api/src/services/auth.ts, added in Milestone 5). The raw
// token lives only in the httpOnly session cookie on the client.
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectStatus {
  planning
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  name        String
  description String?
  status      ProjectStatus @default(planning)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requirementsVersions RequirementsVersion[]
  prdVersions          PrdVersion[]
  architectureVersions ArchitectureVersion[]
  epicVersions         EpicVersion[]
  taskVersions         TaskVersion[]
  repositoryConnection RepositoryConnection?
  codebaseIndex        CodebaseIndex?
  codeChunks           CodeChunk[]
  questions            Question[]
  codeReviews          CodeReview[]

  @@index([ownerId])
  @@map("projects")
}

// One row per requirements analysis run (or manual edit) for a project.
// `content` is validated structured JSON (see api/src/schemas/requirements.ts
// and ai-service/app/schemas.py — the same shape on both sides), never a raw
// LLM response or an unstructured blob. `isActive` marks the single version
// currently "in use" for the project; the service layer enforces at most one
// active version per project inside a transaction (see
// api/src/services/requirements.ts).
model RequirementsVersion {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  version   Int
  ideaText  String   @map("idea_text")
  content   Json
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prdVersions PrdVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("requirements_versions")
}

// One row per PRD generation run (or manual edit) for a project. `content`
// is validated structured JSON, generated from — and tracing back to —
// whichever RequirementsVersion was active at generation time via
// `sourceRequirementsVersionId`. Same single-active-version invariant as
// RequirementsVersion, enforced the same way (see
// api/src/services/prd.ts).
model PrdVersion {
  id                          String   @id @default(uuid())
  projectId                   String   @map("project_id")
  version                     Int
  sourceRequirementsVersionId String   @map("source_requirements_version_id")
  content                     Json
  isActive                    Boolean  @default(false) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRequirementsVersion RequirementsVersion   @relation(fields: [sourceRequirementsVersionId], references: [id])
  architectureVersions      ArchitectureVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceRequirementsVersionId])
  @@map("prd_versions")
}

// One row per architecture-generation run (or manual edit) for a project.
// `content` is validated structured JSON, generated from — and tracing back
// to — whichever PrdVersion was active at generation time via
// `sourcePrdVersionId`. Same single-active-version invariant as PrdVersion,
// enforced the same way (see api/src/services/architecture.ts).
model ArchitectureVersion {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  version            Int
  sourcePrdVersionId String   @map("source_prd_version_id")
  content            Json
  isActive           Boolean  @default(false) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourcePrdVersion PrdVersion    @relation(fields: [sourcePrdVersionId], references: [id])
  epicVersions     EpicVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourcePrdVersionId])
  @@map("architecture_versions")
}

// One row per epic-generation run (or manual edit) for a project. `content`
// is validated structured JSON — a list of id-bearing epic items (mirrors
// RequirementItem[], not PrdContent/ArchitectureContent's flat-sections
// shape) — generated from, and tracing back to, whichever ArchitectureVersion
// was active at generation time via `sourceArchitectureVersionId`. Same
// single-active-version invariant as every prior artifact, enforced the same
// way (see api/src/services/epics.ts).
model EpicVersion {
  id                          String   @id @default(uuid())
  projectId                   String   @map("project_id")
  version                     Int
  sourceArchitectureVersionId String   @map("source_architecture_version_id")
  content                     Json
  isActive                    Boolean  @default(false) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceArchitectureVersion ArchitectureVersion @relation(fields: [sourceArchitectureVersionId], references: [id])
  taskVersions              TaskVersion[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceArchitectureVersionId])
  @@map("epic_versions")
}

// One row per task-generation run (or manual edit) for a project. `content`
// is validated structured JSON — a list of id-bearing task items, each
// referencing an epic id from the source EpicVersion's content via a plain
// `epicId` string field (not a DB-level foreign key — the same way no
// content field anywhere in this schema cross-references another content
// field's items by FK; content is JSON throughout). Generated from, and
// tracing back to, whichever EpicVersion was active at generation time via
// `sourceEpicVersionId`. Same single-active-version invariant as every prior
// artifact (see api/src/services/tasks.ts).
model TaskVersion {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  version             Int
  sourceEpicVersionId String   @map("source_epic_version_id")
  content             Json
  isActive            Boolean  @default(false) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEpicVersion EpicVersion @relation(fields: [sourceEpicVersionId], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceEpicVersionId])
  @@map("task_versions")
}

enum RepositoryConnectionStatus {
  pending
  verified
  error
}

// Exactly one connection per project (not a versioned artifact like every
// AI-generated table above — see docs/GITHUB_INTEGRATION_PHASE_PLAN.md for
// why a connection is modeled as replaced state rather than an append-only
// history). `encryptedToken` is never the plaintext PAT — see
// api/src/lib/githubTokenCrypto.ts for the AES-256-GCM scheme and
// api/src/env.ts for the (optional) GITHUB_TOKEN_ENCRYPTION_KEY it requires.
// `tokenLast4` is the only token-derived value ever safe to return to a
// client.
model RepositoryConnection {
  id                 String                     @id @default(uuid())
  projectId          String                     @unique @map("project_id")
  githubOwner        String                     @map("github_owner")
  githubRepo         String                     @map("github_repo")
  githubRepoId       String?                    @map("github_repo_id")
  githubAccountLogin String?                    @map("github_account_login")
  repositoryUrl      String                     @map("repository_url")
  defaultBranch      String?                    @map("default_branch")
  selectedBranch     String?                    @map("selected_branch")
  status             RepositoryConnectionStatus @default(pending)
  lastVerifiedAt     DateTime?                  @map("last_verified_at")
  lastError          String?                    @map("last_error")
  encryptedToken     String                     @map("encrypted_token")
  tokenLast4         String                     @map("token_last_4")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codebaseIndexes CodebaseIndex[]

  @@map("repository_connections")
}

enum CodebaseIndexStatus {
  pending
  indexing
  completed
  failed
}

// Exactly one index per project (same replaced-state shape as
// RepositoryConnection, not a versioned artifact — see
// docs/CODEBASE_INDEX_PHASE_PLAN.md). Indexing the same connection again
// reuses this row; its files/symbols are replaced wholesale in a
// transaction rather than accumulating history. `repositoryConnectionId` is
// a plain (non-cascading) FK: disconnecting a repository does not delete
// its index in the same request — see the plan doc's "known limitations".
model CodebaseIndex {
  id                     String              @id @default(uuid())
  projectId              String              @unique @map("project_id")
  repositoryConnectionId String              @map("repository_connection_id")
  branch                 String
  commitSha              String?             @map("commit_sha")
  status                 CodebaseIndexStatus @default(pending)
  truncated              Boolean             @default(false)
  fileCount              Int                 @default(0) @map("file_count")
  parsedFileCount        Int                 @default(0) @map("parsed_file_count")
  failedFileCount        Int                 @default(0) @map("failed_file_count")
  startedAt              DateTime?           @map("started_at")
  completedAt            DateTime?           @map("completed_at")
  error                  String?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryConnection RepositoryConnection @relation(fields: [repositoryConnectionId], references: [id])
  files                IndexedFile[]
  codeChunks           CodeChunk[]
  questions            Question[]
  codeReviews          CodeReview[]

  @@index([repositoryConnectionId])
  @@map("codebase_indexes")
}

enum FileParseStatus {
  parsed
  unsupported
  parse_error
  skipped_binary
  skipped_too_large
  skipped_index_limit
}

// One row per file considered during an index run (not just successfully
// parsed ones — a skipped/unsupported/failed file is still recorded, never
// silently dropped from the list; see docs/CODEBASE_INDEX_PHASE_PLAN.md).
// No source content is stored, only `contentHash` (for future
// change-detection) — symbols carry line ranges, not text.
model IndexedFile {
  id          String          @id @default(uuid())
  indexId     String          @map("index_id")
  path        String
  language    String?
  sizeBytes   Int             @map("size_bytes")
  contentHash String          @map("content_hash")
  parseStatus FileParseStatus @map("parse_status")
  parseError  String?         @map("parse_error")
  createdAt   DateTime        @default(now()) @map("created_at")

  index      CodebaseIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  symbols    Symbol[]
  codeChunks CodeChunk[]

  @@unique([indexId, path])
  @@map("indexed_files")
}

// One row per extracted symbol (class/interface/type_alias/function/method
// — see docs/CODEBASE_INDEX_PHASE_PLAN.md for the exact tree-sitter node-type
// mapping). `type`/`signature` are plain strings rather than enums since the
// set of symbol kinds already spans three unrelated language grammars and is
// meant to grow as more languages are added. `parentId` self-references for
// nested symbols (e.g. a method inside a class, a closure inside a method).
model Symbol {
  id        String  @id @default(uuid())
  fileId    String  @map("file_id")
  name      String
  type      String
  startLine Int     @map("start_line")
  endLine   Int     @map("end_line")
  parentId  String? @map("parent_id")
  signature String?

  file       IndexedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parent     Symbol?     @relation("SymbolParent", fields: [parentId], references: [id], onDelete: SetNull)
  children   Symbol[]    @relation("SymbolParent")
  codeChunks CodeChunk[]

  @@index([fileId])
  @@index([parentId])
  @@map("symbols")
}

// One row per code chunk derived from a Phase 7 parsed file/symbol — the
// unit that gets embedded and ranked for search (see
// docs/RETRIEVAL_PHASE_PLAN.md). Chunking is pure string-slicing done in the
// Node API, not ai-service; `symbolId` is null for a whole-file fallback
// chunk (a parsed file with zero extracted symbols). `branch`/`commitSha`
// are denormalized from the owning CodebaseIndex at chunking time so a
// chunk's indexed state is self-describing even if the index is later
// reindexed to a new commit. `contentHash` (sha256 of the chunk's own text)
// is the real dedup key — `symbolId` alone can't be, since Postgres unique
// indexes treat NULL as distinct from NULL.
model CodeChunk {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  codebaseIndexId String   @map("codebase_index_id")
  fileId          String   @map("file_id")
  symbolId        String?  @map("symbol_id")
  branch          String
  commitSha       String   @map("commit_sha")
  chunkIndex      Int      @map("chunk_index")
  content         String
  contentHash     String   @map("content_hash")
  language        String
  startLine       Int      @map("start_line")
  endLine         Int      @map("end_line")
  createdAt       DateTime @default(now()) @map("created_at")

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codebaseIndex     CodebaseIndex      @relation(fields: [codebaseIndexId], references: [id], onDelete: Cascade)
  file              IndexedFile        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  symbol            Symbol?            @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  embeddings        Embedding[]
  answerSources     AnswerSource[]
  codeReviewSources CodeReviewSource[]

  @@unique([codebaseIndexId, commitSha, contentHash])
  @@index([projectId])
  @@index([codebaseIndexId, commitSha])
  @@map("code_chunks")
}

// One row per (chunk, embedding model) pair — `@@unique([chunkId, model])`
// is this schema's direct answer to "do not store duplicate embeddings for
// identical chunks and model versions." `vector` is a plain PostgreSQL
// `Float[]` column (not pgvector — see docs/RETRIEVAL_PHASE_PLAN.md for why);
// similarity ranking is computed in the Node API, not in the database.
model Embedding {
  id         String   @id @default(uuid())
  chunkId    String   @map("chunk_id")
  model      String
  dimensions Int
  vector     Float[]
  createdAt  DateTime @default(now()) @map("created_at")

  chunk CodeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, model])
  @@index([chunkId])
  @@map("embeddings")
}

// One row per question asked against a project's indexed codebase (see
// docs/QA_PHASE_PLAN.md). Not a conversation/chat thread — each question is
// answered independently, grounded fresh against whatever the current
// index's (branch, commitSha) is at ask time; `branch`/`commitSha` are
// denormalized here (matching CodeChunk's own precedent) so a past
// question's indexed state remains visible even after a later reindex.
model Question {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  codebaseIndexId String   @map("codebase_index_id")
  question        String
  branch          String
  commitSha       String   @map("commit_sha")
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codebaseIndex CodebaseIndex @relation(fields: [codebaseIndexId], references: [id], onDelete: Cascade)
  answer        Answer?

  @@index([projectId])
  @@map("questions")
}

// Exactly one answer per question. `insufficientEvidence` is set (with
// `model: "none"`) when retrieval returned nothing usable — the Q&A service
// never calls Claude in that case, so there is no provider model identity
// to record. Never stores a file path, symbol name, or line number directly
// — those live only on the real CodeChunk rows referenced through
// AnswerSource; see docs/QA_PHASE_PLAN.md for why that split is the
// citation-safety mechanism, not an incidental normalization choice.
model Answer {
  id                   String   @id @default(uuid())
  questionId           String   @unique @map("question_id")
  answer               String
  insufficientEvidence Boolean  @default(false) @map("insufficient_evidence")
  model                String
  createdAt            DateTime @default(now()) @map("created_at")

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sources  AnswerSource[]

  @@map("answers")
}

// One row per source chunk actually sent to the model as evidence for one
// answer — not just the ones the model ended up citing (`cited` records
// that separately). `score` is the retrieval-time cosine similarity,
// preserved even though CodeChunk itself carries no score (scores are
// query-specific, not a property of the chunk). References CodeChunk
// directly rather than duplicating its path/lines/content — a reindex's
// cascade deletion of superseded CodeChunk rows correctly removes the
// detailed evidence here too, while the parent Answer's own text and
// `insufficientEvidence` flag remain (documented as a known limitation:
// old Q&A history's evidence detail doesn't survive a reindex, only its
// answer text does).
model AnswerSource {
  id          String  @id @default(uuid())
  answerId    String  @map("answer_id")
  chunkId     String  @map("chunk_id")
  sourceOrder Int     @map("source_order")
  cited       Boolean @default(false)
  score       Float

  answer Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
  chunk  CodeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([answerId, chunkId])
  @@index([answerId])
  @@map("answer_sources")
}

enum CodeReviewStatus {
  pending
  completed
  failed
}

// One row per code-review run against a project's indexed codebase (see
// docs/CODE_REVIEW_PHASE_PLAN.md). Not a versioned artifact like the
// requirements/PRD/architecture/epic/task tables — each review is its own
// independent, append-only history entry, matching Question's own "one row
// per request" shape rather than RepositoryConnection's "replaced state"
// shape. `branch`/`commitSha` are denormalized from the owning
// CodebaseIndex at creation time (same precedent as Question/CodeChunk) so
// a past review's indexed state remains visible after a later reindex.
// `status` starts "pending" once evidence exists and the row is persisted
// (before the provider call), then becomes "completed" or "failed" —
// deliberately more durable than Phase 9's Question/Answer split; see the
// plan doc's "Provider failure behavior" section for why.
model CodeReview {
  id              String           @id @default(uuid())
  projectId       String           @map("project_id")
  codebaseIndexId String           @map("codebase_index_id")
  scope           String
  branch          String
  commitSha       String           @map("commit_sha")
  status          CodeReviewStatus @default(pending)
  summary         String?
  findingCount    Int              @default(0) @map("finding_count")
  model           String?
  error           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  completedAt     DateTime?        @map("completed_at")

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codebaseIndex CodebaseIndex       @relation(fields: [codebaseIndexId], references: [id], onDelete: Cascade)
  sources       CodeReviewSource[]
  findings      CodeReviewFinding[]

  @@index([projectId])
  @@map("code_reviews")
}

// One row per source chunk actually sent to the review provider as evidence
// for one review — not just the ones a finding ends up citing (mirrors
// AnswerSource's "every source sent, not just cited ones" shape). Owned by
// the review itself (not by any one finding), since one shared evidence set
// backs every finding in a review — unlike Q&A, where one answer has its
// own private evidence set. References CodeChunk directly rather than
// duplicating its path/lines/content, so a reindex's cascade deletion of
// superseded CodeChunk rows correctly removes this detailed evidence too,
// while the parent CodeReview's and CodeReviewFinding's own text survive
// (same documented, accepted limitation as AnswerSource).
model CodeReviewSource {
  id          String @id @default(uuid())
  reviewId    String @map("review_id")
  chunkId     String @map("chunk_id")
  sourceOrder Int    @map("source_order")
  score       Float

  review       CodeReview                @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  chunk        CodeChunk                 @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  findingLinks CodeReviewFindingSource[]

  @@unique([reviewId, chunkId])
  @@index([reviewId])
  @@map("code_review_sources")
}

enum CodeReviewFindingSeverity {
  critical
  high
  medium
  low
  info
}

enum CodeReviewFindingCategory {
  bug
  security
  reliability
  performance
  maintainability
  validation
  error_handling
  testing
  architecture
  other
}

enum CodeReviewFindingConfidence {
  high
  medium
  low
}

// One row per finding within a review. Never stores a file path, symbol
// name, or line number directly — those are always resolved through
// CodeReviewFindingSource -> CodeReviewSource -> CodeChunk, the same
// citation-safety split AnswerSource established for Q&A (see the plan
// doc's "Evidence and citation rules"). `actionable` records whether the
// finding came with a concrete recommendation the user could act on versus
// a more general observation; it is informational only — DevForge never
// acts on it itself.
model CodeReviewFinding {
  id             String                      @id @default(uuid())
  reviewId       String                      @map("review_id")
  title          String
  description    String
  severity       CodeReviewFindingSeverity
  category       CodeReviewFindingCategory
  confidence     CodeReviewFindingConfidence
  recommendation String
  actionable     Boolean                     @default(true)
  createdAt      DateTime                    @default(now()) @map("created_at")

  review  CodeReview                @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sources CodeReviewFindingSource[]

  @@index([reviewId])
  @@map("code_review_findings")
}

// Many-to-many join between a finding and the review's shared sources it
// actually cites — a finding may cite several sources, and a source may
// support several findings, which AnswerSource's one-answer-to-many-sources
// shape didn't need to express but a review-with-many-findings does. Every
// row here corresponds to a real, in-range cited_source_number the provider
// returned (validated at both the ai-service and Node layers before
// persistence — see the plan doc); a finding left with zero valid citations
// after filtering is dropped entirely, never persisted with an empty
// sources list.
model CodeReviewFindingSource {
  id        String @id @default(uuid())
  findingId String @map("finding_id")
  sourceId  String @map("source_id")

  finding CodeReviewFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  source  CodeReviewSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([findingId, sourceId])
  @@index([findingId])
  @@index([sourceId])
  @@map("code_review_finding_sources")
}
