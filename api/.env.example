# Copy to api/.env and fill in real values for local (non-Docker)
# development. Never commit a real .env file. Full documentation of every
# variable: ../docs/CONFIGURATION.md. This file is kept in sync with the
# root ../.env.example, which is the single source of truth.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://devforge:devforge@localhost:5433/devforge
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string
FRONTEND_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8001
# Optional — generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=info
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
