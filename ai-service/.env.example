# Copy to ai-service/.env and fill in real values. Never commit a real .env
# file. Full documentation: ../docs/CONFIGURATION.md.

# All three optional. Unset means ai-service still starts and serves /health
# normally, but real-provider endpoints return a real 503
# PROVIDER_NOT_CONFIGURED instead of a fabricated result.
#
# GEMINI_API_KEY and ANTHROPIC_API_KEY are two independent, fully supported
# LLM providers. Gemini is used whenever GEMINI_API_KEY is set (it has a
# genuinely free tier — get a key at https://aistudio.google.com/apikey, no
# billing setup required). Anthropic is used when only ANTHROPIC_API_KEY is
# set. If both are set, Gemini wins.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Unrelated to the two above — enables real Voyage AI embeddings.
VOYAGE_API_KEY=
