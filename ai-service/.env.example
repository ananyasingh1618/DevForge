# Copy to ai-service/.env and fill in real values. Never commit a real .env
# file. Full documentation: ../docs/CONFIGURATION.md.

# Both optional. Unset means ai-service still starts and serves /health
# normally, but real-provider endpoints return a real 503
# PROVIDER_NOT_CONFIGURED instead of a fabricated result.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
